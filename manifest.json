{
  "manifest_version": 3,
  "name": "Better VBTV",
  "version": "1.3.1",
  "description": "Watch VBTV (Volleyball World TV) replays spoiler-free, with keyboard seek, playback speed, shortcuts overlay, and resume history.",
  "permissions": ["activeTab", "storage", "alarms"],
  "host_permissions": ["https://*.supabase.co/*"],
  "action": {
    "default_popup": "src/index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.volleyballworld.com/*"],
      "js": ["src/content.ts"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
