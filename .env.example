# Supabase credentials for watch-history sync. Copy to `.env` (gitignored).
# Leave any of these blank to disable sync entirely — the extension then keeps
# watch history in local storage only, exactly as it did before.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
VITE_SUPABASE_EMAIL=<account email>
VITE_SUPABASE_PASSWORD=<account password>
